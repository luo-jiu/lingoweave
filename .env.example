# Optional. Defaults work without creating a .env file.
NODE_ENV=development
HOST=127.0.0.1
PORT=4310
DATA_DIR=data
CODEX_BIN=codex
# Optional: enables the native mini API; its private token is created at this path.
# MINI_TOKEN_FILE=/absolute/path/to/service/token
# Optional. Existing managed offline speech environment; generated assets stay in DATA_DIR/audio.
# MINI_TTS_ROOT=/Users/your-name/sdks/lingoweave-tts
