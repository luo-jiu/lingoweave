{
  "name": "lingoweave",
  "version": "0.1.0",
  "private": true,
  "description": "LingoWeave · 语织 — an agent-assisted English learning workspace",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @lingoweave/contracts build && concurrently --kill-others --names contracts,server,web \"pnpm --filter @lingoweave/contracts dev\" \"pnpm --filter @lingoweave/server dev\" \"pnpm --filter @lingoweave/web dev\"",
    "build": "pnpm --filter @lingoweave/contracts build && pnpm --parallel --filter './apps/*' build",
    "start": "node --import ./scripts/production-env.mjs apps/server/dist/index.js",
    "typecheck": "pnpm --filter @lingoweave/contracts build && pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @lingoweave/contracts build && pnpm --filter @lingoweave/server test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
